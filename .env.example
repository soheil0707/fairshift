# FAIRSHIFT ENVIRONMENT CONFIGURATION
# UN SDG 8 (Decent Work & Economic Growth)

# Next.js Server & Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google Gemini API (Server-side hazard triage and multilingual translation)
# If omitted, FairShift automatically falls back to deterministic multilingual keyword rules.
GEMINI_API_KEY=""

# Optional: Supabase Connection (PostgreSQL + RLS + Auth)
# If omitted, FairShift seamlessly operates with full local reactive mock persistence for evaluation.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
